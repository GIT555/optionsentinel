[Unit]
Description=Option Sentinel Trading Dashboard (24/7 Always-On)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/OptionTradingDashboard
ExecStart=/usr/bin/python3 option_sentinel.py --server --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
